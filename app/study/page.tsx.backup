// ============================================================================
// Mastery gates — must be green to unlock next Phase
// ============================================================================
const PHASE1_SKILLS = ['Fractions', 'Decimals', 'Ratios', 'Part-of / fraction-of'];
const PHASE2_SKILLS = ['Percents (all 3 types)', 'Rates', 'Units'];
const PHASE3_SKILLS = ['Geometry (P/A/V)', 'Algebra (1-var)'];

type ErrorEntry = { id: string; date: string; section: string; missType: string; note: string; cleared?: boolean };

type ReviewResult = { date: string; missType: string; score: number; total: number };

type Store = {
  done: Record<string, number>;
  weekLog: Record<string, string[]>;
  arDiag?: number;
  mkDiag?: number;
  errorLog: ErrorEntry[];
  masteryChecks: Record<string, boolean>;
  milestonesHit: Record<string, boolean>;
  reviewResults: ReviewResult[];
  sessionState?: Record<string, 'in-progress'|'complete'>;
};

const empty: Store = {
  done: {
    intro:16, diag:5, skills:7, reading:0, grammar:0, vocab:0, basic:2, adv:0,
    algebra:0, geom:0, bio:0, chem:0, earth:0, anat:0, phys:0,
    elec:0, auto:0, mech:0, asmb:0, vids:0, post:0, practice:0, extra:0,
  },
  weekLog: {}, errorLog: [], masteryChecks: {}, milestonesHit: {}, reviewResults: [], sessionState: {},
};

function isoWeek(d = new Date()): string {
  const date = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
  const dayNum = date.getUTCDay() || 7;
  date.setUTCDate(date.getUTCDate() + 4 - dayNum);
  const yearStart = new Date(Date.UTC(date.getUTCFullYear(), 0, 1));
  const week = Math.ceil((((date.getTime() - yearStart.getTime()) / 86400000) + 1) / 7);
  return `${date.getUTCFullYear()}-W${String(week).padStart(2, '0')}`;
}
function planWeekNumber(now = new Date(), totalWeeks = 10): number {
  const start = new Date(PLAN_START + 'T00:00:00');
  const diffDays = Math.floor((now.getTime() - start.getTime()) / 86400000);
  return Math.max(1, Math.min(totalWeeks, Math.floor(diffDays / 7) + 1));
}
function pickTrack(ar?: number): Track | null {
  if (ar == null) return null;
  if (ar >= 60) return 'A'; if (ar >= 45) return 'B'; return 'C';
}
function weeksForTrack(t: Track): Week[] { return t === 'A' ? WEEKS_A : t === 'B' ? WEEKS_B : WEEKS_C; }

function load(): Store {
  if (typeof window === 'undefined') return empty;
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (!raw) return empty;
    const p = JSON.parse(raw) as Partial<Store>;
    return {
      done: { ...empty.done, ...(p.done || {}) },
      weekLog: p.weekLog || {},
      arDiag: p.arDiag, mkDiag: p.mkDiag,
      errorLog: p.errorLog || [],
      masteryChecks: p.masteryChecks || {},
      milestonesHit: p.milestonesHit || {},
      reviewResults: p.reviewResults || [],
      sessionState: p.sessionState || {},
    };
  } catch { return empty; }
}
function save(s: Store) {
  if (typeof window === 'undefined') return;
  localStorage.setItem(STORAGE_KEY, JSON.stringify(s));
  void pushSfprepSync();
}

// ============================================================================
// GT progress estimator (DIRECTIONAL GAUGE — not the real percentile score)
//  Real GT is percentile-curve based (ASVAB norms); we can't compute it exactly.
//  This maps diagnostic %s to a realistic GT band so the bar is motivating, not
//  misleading. Anchors: VE ~80% + AR ~50% ≈ GT ~95 (needs AR work to clear 110);
//  VE ~80% + AR ~75% ≈ GT ~110; strong both ≈ 115+.
//  GT weights Verbal + Arithmetic Reasoning. VE is already strong; AR is the lever.
// ============================================================================
const WK_PCT = 86; // diagnostic
const PC_PCT = 75; // diagnostic
function estimateGT(arPct?: number): number | null {
  if (arPct == null) return null;
  const ve = (WK_PCT + PC_PCT) / 2;   // 80.5
  // Blend: VE and AR contribute ~equally to GT. Map the average % onto a GT
  // band roughly centered so 65%→~100, 80%→~110, 90%→~118.
  const avg = (ve + arPct) / 2;       // e.g. (80.5 + 50)/2 = 65.25
  const gt = Math.round(70 + avg * 0.62);
  return Math.min(130, gt);
}

// ============================================================================
// Component
// ============================================================================
// === D. Episodes tab — surfaces the NotebookLM sources the cron generates ===
type Episode = { n: number; title: string; status: 'ready'|'next'|'locked'; file: string|null; path: string|null };
function EpisodesTab() {
  const [eps, setEps] = useState<Episode[]>([]);
  const [loaded, setLoaded] = useState(false);
  useEffect(() => {
    fetch('/api/episodes').then(r => r.json())
      .then(d => setEps(Array.isArray(d.episodes) ? d.episodes : []))
      .catch(() => setEps([]))
      .finally(() => setLoaded(true));
  }, []);
  return (
    <div className="bg-gray-800 rounded-lg p-4">
      <h2 className="text-lg font-semibold mb-1">🎧 Audio Study Episodes</h2>
      <p className="text-xs text-gray-400 mb-4">A new NotebookLM source drops each weekday 7 AM. Upload it → Generate Audio Overview → listen while you ruck.</p>
      {!loaded && <p className="text-gray-500 text-sm">Loading…</p>}
      {loaded && eps.length === 0 && <p className="text-gray-500 text-sm">No episodes yet — first one generates tomorrow morning.</p>}
      <div className="space-y-2">
        {eps.map(ep => (
          <div key={ep.n} className={`rounded-lg p-3 border-l-4 ${ep.status==='ready'?'bg-gray-900 border-green-500':ep.status==='next'?'bg-gray-900 border-blue-500':'bg-gray-900/50 border-gray-700 opacity-60'}`}>
            <div className="flex items-center justify-between">
              <div className="text-sm font-semibold">
                Ep {ep.n}/12 · {ep.title}
              </div>
              <span className={`text-[10px] uppercase px-2 py-0.5 rounded ${ep.status==='ready'?'bg-green-900 text-green-300':ep.status==='next'?'bg-blue-900 text-blue-300':'bg-gray-800 text-gray-500'}`}>
                {ep.status==='ready'?'ready':ep.status==='next'?'next up':'locked'}
              </span>
            </div>
            {ep.status==='ready' && ep.file && (
              <div className="text-[11px] text-gray-400 mt-1.5">
                📄 <code className="text-blue-300">{ep.file}</code>
                <div className="mt-1">Open <a href="https://notebooklm.google.com" target="_blank" rel="noopener" className="text-blue-400 underline">notebooklm.google.com</a> → New notebook → upload this source → Generate Audio Overview.</div>
              </div>
            )}
            {ep.status==='next' && <div className="text-[11px] text-blue-300 mt-1">Generates next weekday 7 AM.</div>}
          </div>
        ))}
      </div>
    </div>
  );
}

// === D. Episodes tab — surfaces the NotebookLM sources the cron generates ===
export default function StudyPage() {
  const [store, setStore] = useState<Store>(empty);
  const [tab, setTab] = useState<'plan'|'log'|'sections'|'episodes'|'rules'>('plan');
  const [review, setReview] = useState<{ missType: ARQuestion['missType']; qs: ARQuestion[]; answers: number[]; done: boolean } | null>(null);
  const [syncLoaded, setSyncLoaded] = useState(false);

  useEffect(() => { void pullSfprepSync().finally(() => { setStore(load()); setSyncLoaded(true); }); }, []);

  const track = pickTrack(store.arDiag);
  const arTaken = store.arDiag != null;
  const mkTaken = store.mkDiag != null;
  const weeks = track ? weeksForTrack(track) : WEEKS_A;
  const currentPlanWeek = planWeekNumber(new Date(), weeks.length);
  const wk = isoWeek();
  const doneThisWeek = store.weekLog[wk] || [];
  const activeWeek = weeks.find(w => w.week === currentPlanWeek) || weeks[0];

  // Mastery gate logic
  const phase1Green = PHASE1_SKILLS.every(k => store.masteryChecks[k]);
  const phase2Green = phase1Green && PHASE2_SKILLS.every(k => store.masteryChecks[k]);
  const phase3Green = phase2Green && PHASE3_SKILLS.every(k => store.masteryChecks[k]);

  const set = (patch: Partial<Store>) => { const s = { ...store, ...patch }; setStore(s); save(s); };
  const setDone = (id: string, val: number) => set({ done: { ...store.done, [id]: val } });
  const toggleSession = (label: string) => {
    const cur = store.weekLog[wk] || [];
    const next = cur.includes(label) ? cur.filter(x => x !== label) : [...cur, label];
    set({ weekLog: { ...store.weekLog, [wk]: next } });
  };
  const cycleSession = (label: string) => {
    const ss = store.sessionState || {};
    const cur = ss[label];
    const wl = store.weekLog[wk] || [];
    if (!cur) {
      // Not started -> In progress
      set({ sessionState: { ...ss, [label]: 'in-progress' } });
    } else if (cur === 'in-progress') {
      // In progress -> Complete (also mark done in weekLog for the counter)
      set({ sessionState: { ...ss, [label]: 'complete' }, weekLog: { ...store.weekLog, [wk]: [...new Set([...wl, label])] } });
    } else {
      // Complete -> Not started (reset)
      const nss = { ...ss }; delete nss[label];
      set({ sessionState: nss, weekLog: { ...store.weekLog, [wk]: wl.filter(x => x !== label) } });
    }
  };
  const toggleMastery = (k: string) => set({ masteryChecks: { ...store.masteryChecks, [k]: !store.masteryChecks[k] } });
  const toggleMilestone = (k: string) => set({ milestonesHit: { ...store.milestonesHit, [k]: !store.milestonesHit[k] } });
  const addError = (e: Omit<ErrorEntry,'id'>) => set({ errorLog: [{ ...e, id: crypto.randomUUID() }, ...store.errorLog].slice(0, 200) });
  const rmError = (id: string) => set({ errorLog: store.errorLog.filter(e => e.id !== id) });

  // Map free-text error-log missTypes to the question bank's taxonomy so
  // "Review misses of type X" actually pulls questions for legacy AR entries.
  const normalizeMissType = (raw: string): ARQuestion['missType'] => {
    const m: Record<string, ARQuestion['missType']> = {
      'unit conversion': 'units', 'units': 'units',
      'careless arithmetic': 'arithmetic', 'arithmetic': 'arithmetic',
      'setup error': 'setup', 'setup': 'setup', 'percent': 'setup', 'elapsed time': 'setup',
      'rate/time': 'translation', 'fraction': 'translation', 'translation': 'translation',
      'distractor': 'distractor', 'misread': 'misread',
    };
    return m[raw] ?? 'setup';
  };
  const startReview = (rawType: string) => {
    const mt = normalizeMissType(rawType);
    const qs = pickReviewSet(mt, 5);
    if (qs.length === 0) return;
    setReview({ missType: mt, qs, answers: new Array(qs.length).fill(-1), done: false });
  };
  const submitReview = () => {
    if (!review) return;
    const score = review.qs.reduce((n, q, i) => n + (review.answers[i] === q.correct ? 1 : 0), 0);
    const result = { date: new Date().toISOString().slice(0,10), missType: review.missType, score, total: review.qs.length };
    // If ≥80%, mark that miss-type's log entries as cleared
    const pct = score / review.qs.length;
    const cleared = pct >= 0.8;
    const newLog = cleared
      ? store.errorLog.map(e => e.missType === review.missType ? { ...e, cleared: true } : e)
      : store.errorLog;
    set({ reviewResults: [result, ...store.reviewResults].slice(0, 50), errorLog: newLog });
    setReview({ ...review, done: true });
  };

  const gtEstimate = estimateGT(store.arDiag);

  // === A. HARD GATE — plan is hidden until BOTH diagnostics are entered ===
  if (!syncLoaded) {
    return (
      <div className="min-h-screen p-4 max-w-7xl mx-auto">
        <h1 className="text-3xl font-bold mb-1">Study</h1>
        <p className="text-gray-400 text-sm mb-6">Loading your plan…</p>
        <Nav />
      </div>
    );
  }
  if (!arTaken || !mkTaken) {
    return (
      <div className="min-h-screen p-4 max-w-7xl mx-auto">
        <h1 className="text-3xl font-bold mb-1">Study</h1>
        <p className="text-gray-400 text-sm mb-6">ASVAB — Peterson&apos;s. Target: GT ≥ 110 for the 18X contract.</p>
        <Nav />
        <div className="bg-red-950 border-2 border-red-600 rounded-lg p-6 md:p-8 max-w-2xl mx-auto mt-12 text-center">
          <div className="text-4xl mb-3">🚨</div>
          <h2 className="text-red-200 font-bold text-xl mb-2">Diagnostics Required</h2>
          <p className="text-red-200/90 text-sm mb-6">
            AR is <b>half your GT score</b> and MK feeds it. The week-by-week plan stays locked
            until both diagnostics are entered — no half-assing the baseline.
          </p>
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6 text-left">
            <div className={`rounded-lg p-4 border ${arTaken ? 'bg-green-950 border-green-700' : 'bg-red-900/40 border-red-700'}`}>
              <p className="font-bold text-sm mb-2">{arTaken ? `✅ AR Diagnostic — ${store.arDiag}%` : '❌ AR Diagnostic'}</p>
              {!arTaken && (
                <div className="flex items-center gap-2">
                  <input type="number" min={0} max={100} placeholder="Enter %"
                    onChange={e => set({ arDiag: e.target.value === '' ? undefined : Number(e.target.value) })}
                    className="bg-gray-900 border border-gray-600 rounded px-2 py-1 w-24 text-white text-sm" />
                  <a href="https://learn.petersons.com/d2l/lms/quizzing/user/quiz_summary.d2l?ou=507327&qi=38954"
                     target="_blank" rel="noopener" className="text-xs text-blue-400 underline">take it →</a>
                </div>
              )}
            </div>
            <div className={`rounded-lg p-4 border ${mkTaken ? 'bg-green-950 border-green-700' : 'bg-red-900/40 border-red-700'}`}>
              <p className="font-bold text-sm mb-2">{mkTaken ? `✅ MK Diagnostic — ${store.mkDiag}%` : '❌ MK Diagnostic'}</p>
              {!mkTaken && (
                <div className="flex items-center gap-2">
                  <input type="number" min={0} max={100} placeholder="Enter %"
                    onChange={e => set({ mkDiag: e.target.value === '' ? undefined : Number(e.target.value) })}
                    className="bg-gray-900 border border-gray-600 rounded px-2 py-1 w-24 text-white text-sm" />
                  <a href="https://learn.petersons.com/d2l/lms/quizzing/user/quiz_summary.d2l?ou=507327&qi=38957"
                     target="_blank" rel="noopener" className="text-xs text-blue-400 underline">take it →</a>
                </div>
              )}
            </div>
          </div>
          <p className="text-red-400 text-xs">🔒 Plan, sessions, and milestones unlock once both scores are in.</p>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen p-4 max-w-7xl mx-auto">
      <h1 className="text-3xl font-bold mb-1">Study</h1>
      <p className="text-gray-400 text-sm mb-4">ASVAB — Peterson&apos;s (983 topics). Target: GT ≥ 110 for 18X.</p>
      <Nav />

      {/* === A. GT PROGRESS HEADER === */}
      {arTaken && (
        <div className="bg-gradient-to-r from-blue-950 via-gray-900 to-green-950 border border-gray-700 rounded-lg p-4 mb-4">
          <div className="flex items-baseline justify-between mb-2">
            <h2 className="text-lg font-bold">🎯 Estimated GT: <span className={gtEstimate! >= 110 ? 'text-green-400' : 'text-yellow-400'}>{gtEstimate}</span></h2>
            <span className="text-sm text-gray-400">Target: 110 · {gtEstimate! >= 110 ? '✅ passing' : `${110 - gtEstimate!} pts to go`}</span>
          </div>
          <div className="h-3 bg-gray-800 rounded overflow-hidden mb-3">
            <div className="h-full bg-gradient-to-r from-red-500 via-yellow-500 to-green-500"
                 style={{ width: `${Math.min(100, (gtEstimate! / 110) * 100)}%` }} />
          </div>
          <div className="grid grid-cols-3 gap-3 text-xs">
            <div className="bg-gray-900/60 rounded p-2">
              <div className="text-gray-400">VE (WK+PC avg)</div>
              <div className="text-blue-400 font-bold text-lg">{((WK_PCT + PC_PCT)/2).toFixed(0)}%</div>
              <div className="text-gray-500 text-[10px]">WK 86% · PC 75%</div>
            </div>
            <div className="bg-gray-900/60 rounded p-2">
              <div className="text-gray-400">AR diagnostic</div>
              <div className={`font-bold text-lg ${store.arDiag! >= 60 ? 'text-green-400' : store.arDiag! >= 45 ? 'text-yellow-400' : 'text-red-400'}`}>{store.arDiag}%</div>
              <div className="text-gray-500 text-[10px]">Track {track}</div>
            </div>
            <div className="bg-gray-900/60 rounded p-2">
              <div className="text-gray-400">MK diagnostic</div>
              <div className="text-gray-300 font-bold text-lg">{mkTaken ? `${store.mkDiag}%` : '—'}</div>
              <div className="text-gray-500 text-[10px]">Not in GT, informational</div>
            </div>
          </div>
        </div>
      )}

      {/* Diagnostic score entry */}
      <div className="bg-gray-900 border border-gray-700 rounded-lg p-3 mb-4 grid grid-cols-1 md:grid-cols-2 gap-3">
        <label className="text-sm text-gray-300 flex items-center gap-2">
          <span className="w-40">AR diagnostic %:</span>
          <input type="number" min={0} max={100} value={store.arDiag ?? ''}
            onChange={e => set({ arDiag: e.target.value === '' ? undefined : Number(e.target.value) })}
            className="bg-gray-800 border border-gray-600 rounded px-2 py-1 w-24 text-white" placeholder="—" />
          <a href="https://learn.petersons.com/d2l/lms/quizzing/user/quiz_summary.d2l?ou=507327&qi=38954" target="_blank" rel="noopener" className="text-xs text-blue-400 underline">take it</a>
        </label>
        <label className="text-sm text-gray-300 flex items-center gap-2">
          <span className="w-40">MK diagnostic %:</span>
          <input type="number" min={0} max={100} value={store.mkDiag ?? ''}
            onChange={e => set({ mkDiag: e.target.value === '' ? undefined : Number(e.target.value) })}
            className="bg-gray-800 border border-gray-600 rounded px-2 py-1 w-24 text-white" placeholder="—" />
          <a href="https://learn.petersons.com/d2l/lms/quizzing/user/quiz_summary.d2l?ou=507327&qi=38957" target="_blank" rel="noopener" className="text-xs text-blue-400 underline">take it</a>
        </label>
      </div>

      {/* BLOCKER — persists until AR entered */}
      {!arTaken && (
        <div className="bg-red-950 border border-red-600 rounded-lg p-4 mb-6">
          <h2 className="text-red-300 font-bold text-base mb-2">🚨 Blocker: AR diagnostic required</h2>
          <p className="text-red-200 text-sm mb-2">Plan is CONDITIONAL until AR is measured. Track branches by score:</p>
          <ul className="text-red-200 text-xs space-y-1 mb-3 ml-4">
            <li><b className="text-green-300">Track A</b> — {TRACK_DEFS.A.arRange}: {TRACK_DEFS.A.program}</li>
            <li><b className="text-yellow-300">Track B</b> — {TRACK_DEFS.B.arRange}: {TRACK_DEFS.B.program}</li>
            <li><b className="text-red-300">Track C</b> — {TRACK_DEFS.C.arRange}: {TRACK_DEFS.C.program}</li>
          </ul>
        </div>
      )}

      {track && (
        <div className={`border rounded-lg p-3 mb-4 ${track==='A'?'bg-green-950 border-green-600':track==='B'?'bg-yellow-950 border-yellow-600':'bg-red-950 border-red-600'}`}>
          <p className="text-sm"><b>Track {track} locked</b> — AR {store.arDiag}%. {TRACK_DEFS[track].program} <span className="text-gray-400">({TRACK_DEFS[track].weeks} weeks)</span></p>
        </div>
      )}

      {/* This-week session cards */}
      <div className="bg-gray-800 rounded-lg p-4 mb-6">
        <div className="flex items-center justify-between mb-1">
          <h2 className="text-lg font-semibold">📚 Week {activeWeek.week} of {weeks.length} · Phase {activeWeek.phase} · {activeWeek.label}</h2>
          <span className="text-sm text-gray-400">{doneThisWeek.length}/{activeWeek.sessions.length} done · ISO {wk}</span>
        </div>
        <p className="text-xs text-gray-400 mb-3">Session: 8–10 min warm-up · 20–25 min core · 5–10 min error log by miss type.</p>
        <div className={`grid grid-cols-1 gap-2 ${activeWeek.sessions.length===4?'md:grid-cols-4':'md:grid-cols-4'}`}>
          {activeWeek.sessions.map((s, idx) => {
            const label = `W${activeWeek.week}:${s.day}${idx}`;
            const st = store.sessionState?.[label];
            const isComplete = st === 'complete';
            const isProgress = st === 'in-progress';
            return (
              <div key={label}
                className={`rounded-lg p-3 text-left border-l-4 transition ${isComplete ? 'bg-gray-900 opacity-70' : isProgress ? 'bg-gray-800 ring-1 ring-yellow-500/60' : 'bg-gray-900'}`}
                style={{ borderColor: LAYER_COLOR[s.layer] }}>
                <div className="text-sm font-semibold flex items-center gap-1">
                  {isComplete && <span className="text-green-400">✓</span>}
                  {isProgress && <span className="text-yellow-400 animate-pulse">●</span>}
                  {s.day} · {s.layer}
                </div>
                <div className="text-[11px] text-gray-300 mt-1 leading-snug">{s.core}</div>
                {s.peterson && <div className="text-[10px] text-gray-500 mt-1 italic">{s.peterson}</div>}
                <button onClick={() => cycleSession(label)}
                  className={`mt-2 w-full text-[11px] font-semibold rounded px-2 py-1 transition ${isComplete ? 'bg-green-900/60 text-green-300 hover:bg-green-800/60' : isProgress ? 'bg-yellow-700 text-white hover:bg-yellow-600' : 'bg-gray-700 text-gray-200 hover:bg-gray-600'}`}>
                  {isComplete ? '✓ Complete — tap to reset' : isProgress ? 'Mark complete →' : 'Start session →'}
                </button>
                {isComplete && (
                  <button onClick={() => setTab('log')}
                    className="mt-1 w-full text-[10px] text-blue-400 hover:text-blue-300 underline">
                    Log misses from this session
                  </button>
                )}
              </div>
            );
          })}
        </div>
      </div>

      {/* Tabs */}
      <div className="flex gap-2 mb-3 border-b border-gray-700">
        {(['plan','log','sections','episodes','rules'] as const).map(t => (
          <button key={t} onClick={() => setTab(t)}
            className={`px-3 py-2 text-sm ${tab===t?'border-b-2 border-blue-500 text-white':'text-gray-400 hover:text-white'}`}>
            {t==='plan'?`${TRACK_DEFS[track||'A'].weeks}-Wk Plan`:t==='log'?'Error Log':t==='sections'?'Sections':t==='episodes'?'🎧 Episodes':'Rules'}
          </button>
        ))}
      </div>

      {tab === 'plan' && (
        <div className="space-y-4">
          <div className="bg-gray-800 rounded-lg p-4">
            <h3 className="text-sm font-bold text-green-300 mb-2">AR Strategy Moves (train into every Monday)</h3>
            <ol className="text-sm text-gray-300 space-y-1 list-decimal ml-5">{AR_STRATEGIES.map((s,i) => <li key={i}>{s}</li>)}</ol>
            <p className="text-xs text-gray-500 mt-3">Timing: CAT AR = 15 q / 55 min (~3.7 min/q). No speed-training until AR accuracy ≥ 80%.</p>
          </div>

          {/* === C. MASTERY GATES BLOCKING PROGRESSION === */}
          <div className="bg-gray-800 rounded-lg p-4">
            <h3 className="text-sm font-bold mb-2">🔓 Mastery Gates — must clear to unlock next Phase</h3>
            <div className="space-y-3">
              <GateGroup title="Phase 1 gates" skills={PHASE1_SKILLS} store={store} onToggle={toggleMastery} green={phase1Green} />
              <GateGroup title={phase1Green ? 'Phase 2 gates' : '🔒 Phase 2 gates (locked)'} skills={PHASE2_SKILLS} store={store} onToggle={toggleMastery} green={phase2Green} locked={!phase1Green} />
              <GateGroup title={phase2Green ? 'Phase 3 gates' : '🔒 Phase 3 gates (locked)'} skills={PHASE3_SKILLS} store={store} onToggle={toggleMastery} green={phase3Green} locked={!phase2Green} />
            </div>
            <p className="text-xs text-gray-500 mt-3">Per skill: translate ✔ · compute w/o calculator ✔ · estimate to check ✔ · explain aloud ✔ · retrieve ≥80% a week later ✔</p>
          </div>

          {/* Full timeline with phase gating */}
          <div className="bg-gray-800 rounded-lg p-4">
            <h3 className="text-sm font-bold mb-3">{TRACK_DEFS[track||'A'].weeks}-Week Program {!arTaken && <span className="text-yellow-400 text-xs">(CONDITIONAL — take AR diagnostic to lock)</span>}</h3>
            <div className={`space-y-3 ${!arTaken ? 'opacity-60' : ''}`}>
              {weeks.map(w => {
                const phaseLocked = (w.phase === 2 && !phase1Green) || (w.phase === 3 && !phase2Green);
                return (
                  <div key={w.week} className={`border rounded p-3 relative ${w.week===currentPlanWeek?'border-blue-500 bg-gray-900':'border-gray-700 bg-gray-900/50'} ${phaseLocked ? 'opacity-40' : ''}`}>
                    {phaseLocked && (
                      <div className="absolute top-2 right-2 text-xs text-yellow-400 font-semibold">🔒 Locked — clear Phase {w.phase-1} gates</div>
                    )}
                    <div className="flex items-baseline justify-between mb-2">
                      <div className="text-sm font-semibold">Wk {w.week} · Phase {w.phase}</div>
                      <div className="text-xs text-gray-400">{w.label}</div>
                    </div>
                    <div className="grid grid-cols-1 md:grid-cols-4 gap-2 text-xs">
                      {w.sessions.map((s, i) => (
                        <div key={i} className="bg-gray-950 rounded p-2 border-l-2" style={{ borderColor: LAYER_COLOR[s.layer] }}>
                          <div className="font-semibold">{s.day} · {s.layer}</div>
                          <div className="text-gray-400 mt-1">{s.core}</div>
                          {s.peterson && <div className="text-gray-600 mt-1 italic">{s.peterson}</div>}
                        </div>
                      ))}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      )}

      {tab === 'log' && <ErrorLogTab
        log={store.errorLog}
        results={store.reviewResults}
        add={addError}
        rm={rmError}
        onReview={startReview}
      />}

      {tab === 'episodes' && <EpisodesTab />}

      {tab === 'sections' && (
        <div className="bg-gray-800 rounded-lg p-4">
          <h2 className="text-lg font-semibold mb-3">Peterson&apos;s Sections (983 topics)</h2>
          <div className="space-y-3">
            {SECTIONS.map(sec => {
              const done = store.done[sec.id] ?? 0;
              const pct = Math.round((done / sec.total) * 100);
              return (
                <div key={sec.id}>
                  <div className="flex items-center justify-between text-sm mb-1">
                    <span className="font-medium">{sec.label}</span>
                    <span className="text-gray-400 text-xs">{done}/{sec.total} ({pct}%)</span>
                  </div>
                  <div className="h-2 bg-gray-900 rounded overflow-hidden mb-1">
                    <div className="h-full rounded" style={{ width: `${pct}%`, background: CAT_COLOR[sec.cat] }} />
                  </div>
                  <input type="range" min={0} max={sec.total} value={done}
                    onChange={e => setDone(sec.id, parseInt(e.target.value, 10))}
                    className="w-full accent-blue-500" />
                </div>
              );
            })}
          </div>
        </div>
      )}

      {tab === 'rules' && (
        <div className="bg-gray-800 rounded-lg p-4">
          <h3 className="text-sm font-bold mb-2">Hard Rules</h3>
          <ol className="text-sm text-gray-200 space-y-2 list-decimal ml-5">{HARD_RULES.map((r,i) => <li key={i}>{r}</li>)}</ol>
        </div>
      )}

      {/* === D. AUTO-REVIEW QUIZ MODAL === */}
      {review && <ReviewModal review={review} setReview={setReview} submit={submitReview} />}
    </div>
  );
}

function GateGroup({ title, skills, store, onToggle, green, locked }: { title: string; skills: string[]; store: Store; onToggle: (k: string) => void; green: boolean; locked?: boolean }) {
  return (
    <div className={`bg-gray-900 rounded p-2 border-l-4 ${green ? 'border-green-500' : locked ? 'border-gray-600' : 'border-yellow-500'}`}>
      <div className="text-xs font-semibold mb-1">{title} {green && <span className="text-green-400">✅</span>}</div>
      <div className="grid grid-cols-2 md:grid-cols-4 gap-1">
        {skills.map(k => (
          <label key={k} className={`flex items-center gap-2 text-xs px-2 py-1 rounded cursor-pointer ${locked ? 'opacity-40 pointer-events-none' : 'hover:bg-gray-800'}`}>
            <input type="checkbox" checked={!!store.masteryChecks[k]} onChange={() => onToggle(k)} className="accent-green-500" />
            <span className={store.masteryChecks[k] ? 'line-through text-gray-500' : 'text-gray-200'}>{k}</span>
          </label>
        ))}
      </div>
    </div>
  );
}

function ErrorLogTab({ log, results, add, rm, onReview }: {
  log: ErrorEntry[]; results: ReviewResult[];
  add: (e: Omit<ErrorEntry,'id'>) => void; rm: (id: string) => void;
  onReview: (mt: ARQuestion['missType']) => void;
}) {
  const [section, setSection] = useState('AR');
  const [missType, setMissType] = useState<ARQuestion['missType']>('translation');
  const [note, setNote] = useState('');
  const submit = () => {
    if (!note.trim()) return;
    add({ date: new Date().toISOString().slice(0,10), section, missType, note: note.trim() });
    setNote('');
  };
  const byType = useMemo(() => {
    const m: Record<string, { total: number; cleared: number }> = {};
    log.forEach(e => {
      m[e.missType] = m[e.missType] || { total: 0, cleared: 0 };
      m[e.missType].total++;
      if (e.cleared) m[e.missType].cleared++;
    });
    return Object.entries(m).sort((a,b) => b[1].total - a[1].total);
  }, [log]);

  return (
    <div className="space-y-4">
      <div className="bg-gray-800 rounded-lg p-4">
        <h3 className="text-sm font-bold mb-2">Log a miss (the study material)</h3>
        <div className="grid grid-cols-1 md:grid-cols-4 gap-2 mb-2">
          <select value={section} onChange={e=>setSection(e.target.value)} className="bg-gray-900 border border-gray-600 rounded px-2 py-1 text-sm">
            <option>AR</option><option>MK</option><option>PC</option><option>WK</option><option>Practice</option>
          </select>
          <select value={missType} onChange={e=>setMissType(e.target.value as ARQuestion['missType'])} className="bg-gray-900 border border-gray-600 rounded px-2 py-1 text-sm">
            <option value="translation">translation</option>
            <option value="setup">setup / equation</option>
            <option value="arithmetic">arithmetic slip</option>
            <option value="units">units</option>
            <option value="distractor">distractor trap</option>
            <option value="misread">misread problem</option>
          </select>
          <input value={note} onChange={e=>setNote(e.target.value)} onKeyDown={e=>e.key==='Enter'&&submit()}
            placeholder="what went wrong (short)"
            className="md:col-span-2 bg-gray-900 border border-gray-600 rounded px-2 py-1 text-sm" />
        </div>
        <button onClick={submit} className="bg-blue-600 hover:bg-blue-500 rounded px-3 py-1.5 text-sm">Log miss</button>
      </div>

      {/* Pattern summary with AUTO-REVIEW buttons — the D feature */}
      {byType.length > 0 && (
        <div className="bg-gray-800 rounded-lg p-4">
          <h3 className="text-sm font-bold mb-2">Miss patterns → auto-review</h3>
          <div className="space-y-2">
            {byType.map(([t, stats]) => (
              <div key={t} className="flex items-center justify-between bg-gray-900 rounded px-3 py-2">
                <div className="flex items-center gap-3 text-sm">
                  <b className="text-yellow-300 capitalize w-28">{t}</b>
                  <span className="text-gray-400 text-xs">{stats.total} logged · {stats.cleared} cleared</span>
                </div>
                <button
                  onClick={() => onReview(t as ARQuestion['missType'])}
                  className="bg-blue-600 hover:bg-blue-500 text-xs rounded px-3 py-1.5 font-semibold">
                  Review 5 Qs →
                </button>
              </div>
            ))}
          </div>
          <p className="text-xs text-gray-500 mt-3">Score ≥ 80% on the mini-set → all logged misses of that type get marked cleared.</p>
        </div>
      )}

      {results.length > 0 && (
        <div className="bg-gray-800 rounded-lg p-4">
          <h3 className="text-sm font-bold mb-2">Recent auto-review results</h3>
          <div className="space-y-1 text-xs">
            {results.slice(0, 8).map((r, i) => {
              const pct = Math.round((r.score / r.total) * 100);
              return (
                <div key={i} className="flex items-center gap-3 bg-gray-900 rounded px-2 py-1">
                  <span className="text-gray-500 w-20">{r.date}</span>
                  <span className="text-yellow-300 w-24">{r.missType}</span>
                  <span className={pct >= 80 ? 'text-green-400 font-semibold' : 'text-red-400'}>{r.score}/{r.total} ({pct}%)</span>
                  {pct >= 80 && <span className="text-green-500">✓ cleared</span>}
                </div>
              );
            })}
          </div>
        </div>
      )}

      <div className="bg-gray-800 rounded-lg p-4">
        <h3 className="text-sm font-bold mb-2">All misses ({log.length})</h3>
        <div className="space-y-1 max-h-96 overflow-y-auto">
          {log.length === 0 && <p className="text-xs text-gray-500 italic">Log a miss after every session.</p>}
          {log.map(e => (
            <div key={e.id} className={`flex items-start gap-2 bg-gray-900 rounded p-2 text-xs ${e.cleared ? 'opacity-50' : ''}`}>
              <div className="text-gray-500 w-20">{e.date}</div>
              <div className="text-blue-300 w-12">{e.section}</div>
              <div className="text-yellow-300 w-24">{e.missType}</div>
              <div className={`flex-1 ${e.cleared ? 'line-through text-gray-500' : 'text-gray-200'}`}>{e.note}</div>
              {e.cleared && <span className="text-green-400 text-[10px]">✓</span>}
              <button onClick={()=>rm(e.id)} className="text-gray-500 hover:text-red-400 text-xs">✕</button>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}

function ReviewModal({ review, setReview, submit }: {
  review: { missType: ARQuestion['missType']; qs: ARQuestion[]; answers: number[]; done: boolean };
  setReview: (r: typeof review | null) => void;
  submit: () => void;
}) {
  const score = review.qs.reduce((n, q, i) => n + (review.answers[i] === q.correct ? 1 : 0), 0);
  const pct = review.done ? Math.round((score / review.qs.length) * 100) : 0;
  const allAnswered = review.answers.every(a => a !== -1);

  return (
    <div className="fixed inset-0 bg-black/80 z-50 flex items-start justify-center overflow-y-auto p-4">
      <div className="bg-gray-900 border border-gray-700 rounded-lg max-w-3xl w-full my-8">
        <div className="p-4 border-b border-gray-700 flex justify-between items-center">
          <h2 className="text-lg font-bold">
            Auto-review: <span className="text-yellow-300 capitalize">{review.missType}</span>
            {review.done && <span className={`ml-3 text-sm ${pct >= 80 ? 'text-green-400' : 'text-red-400'}`}>Score: {score}/{review.qs.length} ({pct}%)</span>}
          </h2>
          <button onClick={() => setReview(null)} className="text-gray-500 hover:text-white text-xl">✕</button>
        </div>
        <div className="p-4 space-y-4 max-h-[70vh] overflow-y-auto">
          {review.qs.map((q, i) => (
            <div key={q.id} className="bg-gray-800 rounded p-3">
              <div className="text-sm font-semibold mb-2">Q{i+1}. {q.prompt}</div>
              <div className="space-y-1">
                {q.choices.map((c, j) => {
                  const selected = review.answers[i] === j;
                  const correct = q.correct === j;
                  let cls = 'bg-gray-900 hover:bg-gray-700 border-gray-700';
                  if (review.done) {
                    if (correct) cls = 'bg-green-900 border-green-600';
                    else if (selected) cls = 'bg-red-900 border-red-600';
                    else cls = 'bg-gray-900 border-gray-700 opacity-60';
                  } else if (selected) {
                    cls = 'bg-blue-900 border-blue-500';
                  }
                  return (
                    <button key={j} disabled={review.done}
                      onClick={() => {
                        const na = [...review.answers]; na[i] = j;
                        setReview({ ...review, answers: na });
                      }}
                      className={`w-full text-left border rounded px-2 py-1.5 text-xs ${cls}`}>
                      {String.fromCharCode(65+j)}. {c}
                    </button>
                  );
                })}
              </div>
              {review.done && (
                <div className="text-xs text-gray-400 mt-2 italic">{q.explain}</div>
              )}
            </div>
          ))}
        </div>
        <div className="p-4 border-t border-gray-700 flex justify-end gap-2">
          {!review.done ? (
            <button onClick={submit} disabled={!allAnswered}
              className="bg-blue-600 hover:bg-blue-500 disabled:bg-gray-700 disabled:cursor-not-allowed rounded px-4 py-2 text-sm font-semibold">
              Submit ({review.answers.filter(a=>a!==-1).length}/{review.qs.length})
            </button>
          ) : (
            <button onClick={() => setReview(null)}
              className="bg-blue-600 hover:bg-blue-500 rounded px-4 py-2 text-sm font-semibold">
              Close {pct >= 80 && '· cleared misses ✓'}
            </button>
          )}
        </div>
      </div>
    </div>
  );
}
